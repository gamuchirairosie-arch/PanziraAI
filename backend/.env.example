# --- core ---
ENV=dev
DATABASE_URL=sqlite:///./panzira.db
# postgres: postgresql+psycopg://panzira:password@localhost:5432/panzira
SECRET_KEY=generate-a-long-random-string
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
PHONE_HASH_PEPPER=another-long-random-string
CORS_ORIGINS=http://localhost:5173
EVIDENCE_DIR=./data/evidence
MAX_UPLOAD_MB=8
# if true, the approving editor must differ from whoever completed the checklist
REQUIRE_FOUR_EYES=false

# --- WhatsApp Cloud API (citizen-initiated chats only) ---
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=

# --- Telegram Bot API ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_EDITOR_CHAT_ID=
# Public Telegram destination for verified alerts, after editor approval only
TELEGRAM_ALERT_CHAT_ID=

# --- Africa's Talking (USSD + SMS) ---
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
# appended to callback URLs as ?key=...
AT_WEBHOOK_SECRET=

# --- Meta Graph API (Pages / Instagram professional accounts you are authorised on) ---
META_GRAPH_TOKEN=
META_GRAPH_VERSION=v21.0

# --- translation: glossary (offline rough gloss) | anthropic (fluent draft, needs key) ---
TRANSLATION_PROVIDER=glossary
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- image safety ---
GRAPHIC_THRESHOLD=0.55
