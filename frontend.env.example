# Default is an explicit browser-only demo. No backend requests are made in demo mode.
VITE_BACKEND_MODE=demo

# For a separately deployed FastAPI service, set mode to server and provide public URLs.
# Never put passwords, API tokens, signing secrets, or provider credentials in VITE variables.
VITE_API_BASE_URL=
VITE_HEALTH_URL=

# Optional public citizen channel links.
VITE_TELEGRAM_BOT_USERNAME=
VITE_WHATSAPP_NUMBER=
VITE_USSD_SERVICE_CODE=
