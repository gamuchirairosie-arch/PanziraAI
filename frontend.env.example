# Public backend origin (or a URL ending in /api). Required when the static frontend
# and FastAPI backend are deployed on different hosts.
VITE_API_BASE_URL=https://api.example.org
# Optional override; normally derived as <VITE_API_BASE_URL>/health.
VITE_HEALTH_URL=

# Optional citizen channel links. Never put provider API credentials in VITE variables.
VITE_TELEGRAM_BOT_USERNAME=PanziraBot
VITE_WHATSAPP_NUMBER=
VITE_USSD_SERVICE_CODE=
